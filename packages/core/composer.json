{
  "name": "agencyga/hitzordu-core",
  "description": "Slot generation and booking rules for Hitzordu",
  "type": "library",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "pestphp/pest": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Hitzordu\\Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
